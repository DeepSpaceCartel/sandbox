# Map of 1Password secret references to env vars. Use with:
#   op run --env-file=.env.1password -- <command>
# Every reference points at the "Sandbox Dev" vault only. Item and field names
# are the ones docs/setup/manual-prerequisites.md asks you to create.

# Hetzner Cloud project "sandbox-dev" (never the Coder project)
TF_VAR_hcloud_token="op://Sandbox Dev/Hetzner sandbox-dev/token"

# Route53: IAM user limited to the sandbox.deepspacecartel.com hosted zone
AWS_ACCESS_KEY_ID="op://Sandbox Dev/Route53 sandbox zone/AWS_ACCESS_KEY_ID"
AWS_SECRET_ACCESS_KEY="op://Sandbox Dev/Route53 sandbox zone/AWS_SECRET_ACCESS_KEY"
TF_VAR_route53_zone_id="op://Sandbox Dev/Route53 sandbox zone/zone_id"

# Terraform state bucket (separate from the Coder state bucket)
TF_VAR_state_bucket="op://Sandbox Dev/Terraform state/bucket"
TF_STATE_ACCESS_KEY_ID="op://Sandbox Dev/Terraform state/AWS_ACCESS_KEY_ID"
TF_STATE_SECRET_ACCESS_KEY="op://Sandbox Dev/Terraform state/AWS_SECRET_ACCESS_KEY"

# GitHub test org + "Sandbox (test)" GitHub App
TF_VAR_github_test_org="op://Sandbox Dev/GitHub App sandbox-test/org"
TF_VAR_github_app_id="op://Sandbox Dev/GitHub App sandbox-test/app_id"
TF_VAR_github_app_client_id="op://Sandbox Dev/GitHub App sandbox-test/client_id"
TF_VAR_github_app_client_secret="op://Sandbox Dev/GitHub App sandbox-test/client_secret"
TF_VAR_github_app_private_key="op://Sandbox Dev/GitHub App sandbox-test/private_key"
TF_VAR_github_app_webhook_secret="op://Sandbox Dev/GitHub App sandbox-test/webhook_secret"
